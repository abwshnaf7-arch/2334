{
 "phrases": [
  {
   "text": "لسه بتقص السكتات وبتكتب الكابشن كلمة كلمة؟",
   "t0": 0.3846153846153846,
   "t1": 3.2211503334244744
  },
  {
   "text": "الكلام ده مبقاش ينفع في ألفين وستة وعشرين.",
   "t0": 3.2980718913294442,
   "t1": 6.076883012820512
  },
  {
   "text": "إنت بتصوّر الفيديو،",
   "t0": 6.326883012820512,
   "t1": 7.307652243589743
  },
  {
   "text": "وبعدين تقعد ساعات تسمع وتقص السكتات،",
   "t0": 7.442267628205127,
   "t1": 9.673036858974358
  },
  {
   "text": "وتشيل الجمل اللي اتعادت،",
   "t0": 9.884575320512818,
   "t1": 11.192267628205126
  },
  {
   "text": "وتكتب الكابشن كلمة كلمة.",
   "t0": 11.403806089743588,
   "t1": 12.355729166666663
  },
  {
   "text": "وقت كله رايح،",
   "t0": 12.596113782051278,
   "t1": 13.586498397435893
  },
  {
   "text": "والريل لسه ما نزلش.",
   "t0": 13.798036858974355,
   "t1": 14.394190705128201
  },
  {
   "text": "الحل بقى في الذكاء الاصطناعي.",
   "t0": 14.913427691202473,
   "t1": 16.29807692307692
  },
  {
   "text": "Happy Duck AI،",
   "t0": 16.374999999999996,
   "t1": 16.721153846153843
  },
  {
   "text": "إضافة لبريمير برو",
   "t0": 16.932692307692303,
   "t1": 17.961538461538456
  },
  {
   "text": "بتعمل الشغل المتعب ده بدالك.",
   "t0": 18.173076923076916,
   "t1": 19.471153846153836
  },
  {
   "text": "افتح الإضافة،",
   "t0": 19.99038461538461,
   "t1": 20.586538461538453
  },
  {
   "text": "وحدد الكليب،",
   "t0": 20.798076923076916,
   "t1": 21.4326923076923
  },
  {
   "text": "واضغط تحليل الصوت.",
   "t0": 21.64423076923076,
   "t1": 22.586538461538453
  },
  {
   "text": "هتشوف الموجة الصوتية،",
   "t0": 22.711538461538453,
   "t1": 23.942307692307683
  },
  {
   "text": "والخط الأصفر اللي إنت اللي بتتحكم في حساسيته.",
   "t0": 24.01923076923076,
   "t1": 26.70192307692307
  },
  {
   "text": "وبعدين تضغط قص وتنقية.",
   "t0": 27.221153846153832,
   "t1": 29.01923076923076
  },
  {
   "text": "الإضافة بتقص على حدود الكلمات الحقيقية،",
   "t0": 29.538461538461526,
   "t1": 31.778846153846143
  },
  {
   "text": "مش على موجة الصوت بس،",
   "t0": 31.990384615384603,
   "t1": 33.01923076923076
  },
  {
   "text": "فمفيش كلمة بتتقص من نصها.",
   "t0": 33.23076923076922,
   "t1": 34.663461538461526
  },
  {
   "text": "وبتشيل السكتات،",
   "t0": 35.1826923076923,
   "t1": 35.90384615384614
  },
  {
   "text": "وبتشيل الجمل المتكررة،",
   "t0": 35.980769230769226,
   "t1": 37.31730769230768
  },
  {
   "text": "وبتقفل الفراغات لوحدها على التايم لاين.",
   "t0": 37.52884615384614,
   "t1": 40.201923076923066
  },
  {
   "text": "يعني قص حقيقي،",
   "t0": 40.27884615384614,
   "t1": 40.89423076923076
  },
  {
   "text": "مش علامات.",
   "t0": 41.10576923076922,
   "t1": 41.62499999999999
  },
  {
   "text": "وبعد القص،",
   "t0": 42.14423076923076,
   "t1": 42.39423076923076
  },
  {
   "text": "دوس إنشاء الكابشن.",
   "t0": 42.48076923076922,
   "t1": 43.53846153846153
  },
  {
   "text": "تفريغ سحابي سريع بالذكاء الاصطناعي،",
   "t0": 43.64423076923076,
   "t1": 46.37499999999999
  },
  {
   "text": "والكابشن ينزل جوه بريمير كلمة بكلمة بالأنيميشن،",
   "t0": 46.58653846153845,
   "t1": 49.58653846153845
  },
  {
   "text": "والكلمة بتنوّر وهي بتتقال.",
   "t0": 49.79807692307691,
   "t1": 51.067307692307686
  },
  {
   "text": "ومصمم للعربي بكل لهجاته،",
   "t0": 51.58653846153845,
   "t1": 52.528846153846146
